# Trading Bot Environment Configuration
# =====================================
# Copy this file to .env and fill in your actual values

# Discord Configuration
# Choose ONE: webhook_url OR (bot_token + channel_id)

# Option 1: Discord Webhook (simpler)
# Get webhook from: Server Settings > Integrations > Webhooks > Create Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Option 2: Discord Bot Token + Channel ID (more control)
# DISCORD_BOT_TOKEN=your_bot_token_here
# DISCORD_CHANNEL_ID=your_channel_id_here

# Data Provider Configuration
# Options: yahoo, ibkr, alpaca
DATA_PROVIDER=yahoo

# Interactive Brokers Configuration (if using IBKR)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Alpaca Configuration (if using Alpaca)
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# TradingView Configuration (if using TradingView data)
TRADINGVIEW_USERNAME=your_username_here
TRADINGVIEW_PASSWORD=your_password_here

# Debugging
DEBUG=false
